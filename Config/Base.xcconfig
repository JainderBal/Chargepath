// Base.xcconfig — attached to the ChargePath target's Debug + Release
// configurations (baseConfigurationReference).
//
// Real secrets live in Config/Secrets.xcconfig, which is git-ignored and
// never pushed to GitHub. The line below pulls it in *if it exists*
// (`#include?` is silent when the file is missing), so the project still
// builds on a fresh clone before you've created it.

// Defaults so every setting is always defined. Override them in Secrets.xcconfig.
//   OPEN_CHARGE_MAP_API_KEY — live map data (empty → keyless, rate-limited → seed)
//   GOOGLE_MAPS_API_KEY     — in-app turn-by-turn navigation (empty → nav screen
//                             shows a "set the key" placeholder)
//   CHARGEHUB_API_KEY       — optional; only the ChargeHub worked-example service
OPEN_CHARGE_MAP_API_KEY =
GOOGLE_MAPS_API_KEY =
CHARGEHUB_API_KEY =

#include? "Secrets.xcconfig"
