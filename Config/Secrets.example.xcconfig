// TEMPLATE — copy this file to `Secrets.xcconfig` (same folder) and paste your
// keys. `Secrets.xcconfig` is git-ignored, so your real keys never get
// committed or pushed to GitHub.
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Notes on .xcconfig syntax: no quotes around the value; `//` starts a
// comment; leading/trailing whitespace is trimmed.


// Open Charge Map — backs the live map.
// Get a key: https://openchargemap.org → sign in → My Profile → My Apps →
// register an app → copy the API key. Optional: OCM also serves keyless
// traffic, just heavily rate-limited. Empty → the app falls back to the
// bundled seed stations.
OPEN_CHARGE_MAP_API_KEY = paste_your_open_charge_map_key_here


// Google Maps Platform — in-app turn-by-turn navigation (Navigation SDK).
// Requires a Google Cloud project with billing enabled, and the
// "Navigation SDK for iOS" + "Maps SDK for iOS" products turned on.
// Free tier ≈ 1,000 destination requests / month. Empty → the Navigation
// screen shows a placeholder instead of a live map.
GOOGLE_MAPS_API_KEY = paste_your_google_maps_platform_key_here


// ChargeHub — optional. Only the ChargeHub worked-example service uses this;
// its free "Demo - POI" tier returns a single fixed POI. Get a key at
// https://developer.chargehub.com (subscribe to "Demo - POI" → Profile →
// Primary key). Empty is fine.
CHARGEHUB_API_KEY = paste_your_chargehub_primary_key_here
