<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>ChargePath</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- API keys. Populated at build time from the build settings of the same
	     name (Config/Base.xcconfig ← Config/Secrets.xcconfig, git-ignored). -->
	<key>OPEN_CHARGE_MAP_API_KEY</key>
	<string>$(OPEN_CHARGE_MAP_API_KEY)</string>
	<key>GOOGLE_MAPS_API_KEY</key>
	<string>$(GOOGLE_MAPS_API_KEY)</string>
	<key>CHARGEHUB_API_KEY</key>
	<string>$(CHARGEHUB_API_KEY)</string>

	<!-- Localization: app ships English + French strings (see Theme/L10n). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>fr</string>
	</array>

	<!--
	  The Map tab uses a fixed Montréal location (FixedLocationService). The
	  in-app turn-by-turn Navigation screen (Google Navigation SDK) needs a
	  real fix, hence these keys + the "location" / "audio" background modes
	  (so voice guidance keeps running when the app is backgrounded).
	-->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ChargePath uses your location to guide you turn-by-turn to charging stops and your destination.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>ChargePath keeps guiding you and announcing turns even when the app is in the background.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>audio</string>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- UIKit, no storyboard: the scene manifest names SceneDelegate explicitly
	     so the system routes scene lifecycle callbacks to it. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
